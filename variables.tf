variable "region" {
  type        = string
  description = "AWS region. Used to scope the CloudWatch log encryption grant in the KMS key policy."
}

variable "account_id" {
  type        = string
  description = "AWS account ID. Used as the root principal in the KMS key policy and to scope the CloudWatch log encryption grant."
}

variable "partition" {
  type        = string
  default     = "aws"
  description = "AWS partition (e.g. `aws`, `aws-us-gov`). Used to construct ARNs in the KMS key policy."
}

variable "block_ref" {
  type        = string
  description = "Short app reference used as the base for resource names."
}

variable "resource_suffix" {
  type        = string
  description = "Random suffix appended to resource names for uniqueness. Generated by the caller (typically a 5-char random_string)."
}

variable "tags" {
  type        = map(string)
  default     = {}
  description = "Tags applied to all AWS resources managed by the scaffold."
}

variable "op_assumer_arns" {
  type        = list(string)
  description = "ARNs of principals allowed to sts:AssumeRole the deployer and image-pusher roles. Typically `[ns_agent_user_arn]`."
}

variable "package_type" {
  type        = string
  default     = "Zip"
  description = "Lambda package type. `Zip` provisions a deployer role with S3 artifact upload + lambda update grants. `Image` provisions a deployer role with lambda update + KMS grant for encrypted ECR pulls, plus an image-pusher role."

  validation {
    condition     = contains(["Zip", "Image"], var.package_type)
    error_message = "package_type must be either \"Zip\" or \"Image\"."
  }
}

variable "lambda_function_arn" {
  type        = string
  description = "ARN of the Lambda function. Used to scope the deployer's `lambda:Update*` / `lambda:PublishVersion` grants."
}

variable "artifacts_bucket_arn" {
  type        = string
  default     = ""
  description = "ARN of the S3 artifacts bucket. Required when `package_type = \"Zip\"`; the deployer role is granted list/get/put/delete on it."
}

variable "ecr_repository_arn" {
  type        = string
  default     = ""
  description = "ARN of the ECR repository. Required when `package_type = \"Image\"`; the image-pusher role is granted ECR push/pull on it."
}

variable "secret_arns" {
  type        = list(string)
  default     = []
  description = "ARNs of Secrets Manager secrets the executor role should be allowed to read. Typically the union of newly-provisioned app secrets and existing secrets pulled in via capabilities."
}

variable "log_retention_in_days" {
  type        = number
  default     = 0
  description = "CloudWatch log retention in days. Forwarded to the wrapped logs module; 0 disables expiration."
}
